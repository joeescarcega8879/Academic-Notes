# ── Django ────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=core.settings.local
DJANGO_SECRET_KEY=django-insecure-cambia-esto-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO

# ── Base de datos ─────────────────────────────────────────────────────
# Vacío => SQLite local (db.sqlite3), como hasta ahora.
# Con Docker Compose, el contenedor inyecta la URL de PostgreSQL.
DATABASE_URL=

# ── PostgreSQL del docker-compose (solo interpolación de Compose) ─────
POSTGRES_DB=gradelink
POSTGRES_USER=gradelink
POSTGRES_PASSWORD=gradelink

# ── Redis / Celery ────────────────────────────────────────────────────
REDIS_URL=
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# True = las tareas corren en el proceso (local sin worker). Docker lo pone en False.
CELERY_TASK_ALWAYS_EAGER=True

# ── Correo ────────────────────────────────────────────────────────────
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@gradelink.app

# ── Sentry (producción, opcional) ─────────────────────────────────────
SENTRY_DSN=
