# ── Django ────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=core.settings.local
DJANGO_SECRET_KEY=django-insecure-cambia-esto-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO

# ── Base de datos ─────────────────────────────────────────────────────
# Vacío => SQLite local (db.sqlite3), como hasta ahora.
# Con Docker Compose, el contenedor inyecta la URL de PostgreSQL.
DATABASE_URL=

# ── PostgreSQL del docker-compose (solo interpolación de Compose) ─────
POSTGRES_DB=gradelink
POSTGRES_USER=gradelink
POSTGRES_PASSWORD=gradelink

# ── Redis / Celery ────────────────────────────────────────────────────
REDIS_URL=
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# True = las tareas corren en el proceso (local sin worker). Docker lo pone en False.
CELERY_TASK_ALWAYS_EAGER=True

# ── Correo ────────────────────────────────────────────────────────────
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@academicnotes.app

# ── IA asistida ───────────────────────────────────────────────────────
# fake = proveedor de mentira (sin red ni costo). gemini = Google; pide GEMINI_API_KEY y GEMINI_MODEL.
AI_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_MODEL=
# free = clave gratuita (Google puede usar lo que recibe): la IA no recibe datos de alumnos. paid = con facturación.
GEMINI_KEY_TIER=free
AI_TIMEOUT_SECONDS=60

# Proxies de confianza delante de la app (0 = ninguno; producción usa 1 por omisión). Define la IP del cliente para los límites de intentos.
TRUSTED_PROXY_COUNT=0

# ── OCR del lote de PDFs (opcional) ───────────────────────────────────
# Sin Tesseract la app funciona igual: solo lee el texto digital de los PDF y las portadas escaneadas se asignan a mano.
# En Windows: `winget install UB-Mannheim.TesseractOCR` y el archivo spa.traineddata en una carpeta tuya; en Linux:
# `apt install tesseract-ocr tesseract-ocr-spa` (el Dockerfile ya lo trae). Con rutas, usar / también en Windows.
OCR_ENABLED=True
OCR_TESSERACT_CMD=
OCR_TESSDATA_DIR=
OCR_LANGUAGE=spa

# ── Sentry (producción, opcional) ─────────────────────────────────────
SENTRY_DSN=
